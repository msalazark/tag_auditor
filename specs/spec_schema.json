{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tag Audit Spec",
  "description": "Schema de validacion para archivos de spec del Tag Audit Tool v2",
  "type": "object",
  "required": ["site", "client", "version", "events"],
  "additionalProperties": false,
  "properties": {
    "site": { "type": "string", "minLength": 1 },
    "client": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "name", "description", "trigger", "priority", "source", "required_params"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string", "enum": ["ecommerce", "leads", "custom"] },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["P1", "P2", "P3"] },
          "source": { "type": "string", "enum": ["dataLayer", "ga4_hit", "both"] },
          "required_params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "type"],
              "additionalProperties": false,
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "enum": ["string", "number", "boolean", "array", "object"] },
                "example": {}
              }
            }
          },
          "optional_params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "type"],
              "additionalProperties": false,
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "enum": ["string", "number", "boolean", "array", "object"] },
                "example": {}
              }
            }
          }
        }
      }
    }
  }
}
