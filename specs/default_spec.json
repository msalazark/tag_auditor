{
  "version": "1.0",
  "description": "Spec de eventos GA4 estándar — cobertura mínima esperada",
  "events": [
    {
      "name": "page_view",
      "trigger": "page_load",
      "required_params": ["page_title", "page_location"],
      "priority": "P1"
    },
    {
      "name": "scroll",
      "trigger": "scroll_depth",
      "required_params": ["percent_scrolled"],
      "priority": "P2"
    },
    {
      "name": "click",
      "trigger": "cta_click",
      "required_params": ["link_text", "link_url"],
      "priority": "P2"
    },
    {
      "name": "generate_lead",
      "trigger": "form_submit",
      "required_params": ["form_name"],
      "priority": "P1"
    },
    {
      "name": "file_download",
      "trigger": "pdf_click",
      "required_params": ["file_name", "link_url"],
      "priority": "P2"
    },
    {
      "name": "view_item",
      "trigger": "product_view",
      "required_params": ["item_id", "item_name", "currency"],
      "priority": "P2"
    },
    {
      "name": "add_to_cart",
      "trigger": "add_to_cart_click",
      "required_params": ["item_id", "item_name", "value", "currency"],
      "priority": "P1"
    },
    {
      "name": "purchase",
      "trigger": "order_confirmation",
      "required_params": ["transaction_id", "value", "currency"],
      "priority": "P1"
    }
  ]
}
