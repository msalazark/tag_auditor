{
  "site": "default.example.com",
  "client": "Cliente Default",
  "version": "1.0",
  "events": [
    {
      "category": "ecommerce",
      "name": "view_item",
      "description": "Vista de detalle de producto",
      "trigger": "Carga de la página de producto",
      "priority": "P1",
      "source": "dataLayer",
      "required_params": [
        {"key": "event", "type": "string", "example": "view_item"},
        {"key": "ecommerce.items[0].item_id", "type": "string", "example": "SKU-001"},
        {"key": "ecommerce.items[0].item_name", "type": "string", "example": "Cemento Tipo I"},
        {"key": "ecommerce.currency", "type": "string", "example": "PEN"},
        {"key": "ecommerce.value", "type": "number", "example": 29.9}
      ],
      "optional_params": [
        {"key": "ecommerce.items[0].item_category", "type": "string"},
        {"key": "ecommerce.items[0].item_brand", "type": "string"}
      ]
    },
    {
      "category": "leads",
      "name": "generate_lead",
      "description": "Envío de formulario de contacto",
      "trigger": "Submit de formulario de lead",
      "priority": "P1",
      "source": "dataLayer",
      "required_params": [
        {"key": "event", "type": "string", "example": "generate_lead"},
        {"key": "form_name", "type": "string", "example": "formulario_contacto"},
        {"key": "form_location", "type": "string", "example": "contacto"}
      ],
      "optional_params": [
        {"key": "lead_type", "type": "string"},
        {"key": "value", "type": "number"}
      ]
    }
  ]
}
